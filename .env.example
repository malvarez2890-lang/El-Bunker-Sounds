# Copia este archivo como ".env" (cp .env.example .env) y rellénalo EN TU SERVIDOR. Nunca lo subas a GitHub.

# --- Dirección pública de la app (la ves en el panel de Tailscale, sección Machines) ---
BASE_URL=https://musica.TU-TAILNET.ts.net

# --- Quién administra (puede aprobar amigos). Separa varios con coma ---
ADMIN_EMAILS=tu-correo@gmail.com

# --- Carpeta de música en el servidor (la que contiene la carpeta "Artista") ---
MUSIC_HOST_DIR=/home/tansis/musica

# --- Tailscale: clave para que el contenedor se una a tu red (solo hace falta la primera vez) ---
TS_AUTHKEY=
TS_HOSTNAME=musica

# --- Correo que envía los códigos (Gmail con "contraseña de aplicación") ---
SMTP_USER=elbunkerservers@gmail.com
SMTP_PASS=
MAIL_FROM=El Búnker Sound <elbunkerservers@gmail.com>

# --- Entrar con Google (opcional; si lo dejas vacío, el botón no aparece) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Enviar música al receptor Onkyo (opcional; sin estas dos líneas no hay botón) ---
# ONKYO_IP=192.168.100.10        # IP del Onkyo
# ONKYO_LAN_IP=192.168.100.201   # IP de ESTE servidor en tu red de casa
# ONKYO_MAX_VOLUME=50            # tope de volumen desde la app (el TX-8130 llega a 80)
# ONKYO_FORMAT=m4a               # m4a (liviano) o wav (los originales, sin recompresión)

# --- Opcionales ---
# AAC_BITRATE=256k
# SCAN_INTERVAL_MIN=15
# SESSION_DAYS=90
